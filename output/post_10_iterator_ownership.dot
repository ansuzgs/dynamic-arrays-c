digraph IteratorOwnership {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="#fafafa",
         label="Iterator ↔ Array Relationship\nPost 10: Iterators and Traversal Patterns",
         labelloc=t, nodesep=0.5, ranksep=0.8];
  node [fontname="Helvetica", fontsize=10, style=filled];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_iterator {
    label="ArrayIterator (24 bytes, stack)";
    style=rounded; color="#1565c0"; penwidth=2;
    fontname="Helvetica"; fontsize=11;

    iter [shape=record, fillcolor="#e3f2fd",
      label="{ArrayIterator|array: Array*\l|index: size_t (= 3)\l|_mod_snapshot: size_t (= 7)\l}"];
  }

  subgraph cluster_array {
    label="Array (heap)";
    style=rounded; color="#2e7d32"; penwidth=2;
    fontname="Helvetica"; fontsize=11;

    arr [shape=record, fillcolor="#c8e6c9",
      label="{Array|data: void*\l|size: 8\l|capacity: 16\l|element_size: 4\l|mod_count: 7  ✓ match\l|destroy_fn: NULL\l}"];

    buf [shape=record, fillcolor="#e8f5e9",
      label="{Buffer (64 bytes)|{[0] 10|[1] 20|[2] 30|<idx3>[3] 40|[4] 50|[5] 60|[6] 70|[7] 80|[8..15] ·}}"];
  }

  iter -> arr [label="  non-owning\n  reference", color="#1565c0", penwidth=2];
  arr -> buf [label="  owns", color="#2e7d32"];
  iter -> buf:idx3 [label="  index=3\n  points here", style=dashed, color="#e65100", penwidth=1.5];

  subgraph cluster_invalid {
    label="After array_push() triggers realloc";
    style=rounded; color="#c62828"; penwidth=2;
    fontname="Helvetica"; fontsize=11;

    iter_stale [shape=record, fillcolor="#ffcdd2",
      label="{ArrayIterator|array: Array*\l|index: 3\l|_mod_snapshot: 7  ✗ stale\l}"];

    arr_new [shape=record, fillcolor="#c8e6c9",
      label="{Array|data: void* (NEW addr)\l|size: 9\l|mod_count: 8  (changed)\l}"];
  }

  iter_stale -> arr_new [label="  snapshot ≠ mod_count\n  → invalidated!", color="#c62828", style=bold];

  subgraph cluster_legend {
    label="Key Insight";
    style=rounded; color="#616161"; penwidth=1;
    fontname="Helvetica"; fontsize=10;
    legend [shape=note, fillcolor="#fff9c4",
      label="Index-based: index 3 is still valid\lafter realloc (buffer moved, index didn't).\l\lPointer-based: a cached pointer into the old\lbuffer is DANGLING after realloc.\l\lmod_count detects the mutation so the\literator can warn instead of silently\lreading wrong data.\l"];
  }
}
